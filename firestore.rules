rules_version = '2';

// Single owner. Everything lives under users/{uid}; only that user can
// read or write it. oauth/ is server-only (admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
