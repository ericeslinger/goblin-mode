rules_version = '2';

// Single owner. Everything lives under users/{uid}, and only that user
// can read it. Writes follow the write path recorded per collection in
// packages/schema/src/model.ts: the client writes notes, reminders and
// devices directly (offline-first); history and activity are written
// only by functions. Anything not listed here is denied, and oauth/ is
// server-only (the admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      match /notes/{noteId} {
        allow read, write: if isOwner(uid);

        match /history/{versionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }

      match /activity/{runId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
