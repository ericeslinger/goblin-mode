rules_version = '2';

// Single owner. Everything lives under users/{uid}, and only that user
// can read it. Writes follow the write path recorded per collection in
// packages/schema/src/model.ts: the client writes notes, reminders,
// devices and settings directly (offline-first), and those writes must
// match the shape the zod contract defines (the generated isValid*
// functions); history and activity are written only by functions.
// Anything not listed here is denied, and oauth/ is server-only (the
// admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // AUTOGENERATED BEGIN: npm run rules:gen. Do not edit by hand.
    function isValidNote(data) {
      return data.keys().hasAll(['kind', 'body', 'title', 'titleSource', 'links', 'tags', 'archived', 'createdAt', 'updatedAt', 'updatedBy', 'deviceId'])
        && data.keys().hasOnly(['kind', 'body', 'title', 'titleSource', 'conceptType', 'parent', 'projectKind', 'projectStatus', 'synonyms', 'links', 'tags', 'templateMode', 'fromTemplate', 'archived', 'mergedInto', 'settledAt', 'createdAt', 'updatedAt', 'updatedBy', 'deviceId', 'baseHash'])
        && (data.kind is string && data.kind in ['text', 'sketch', 'concept', 'template'])
        && data.body is string
        && data.title is string
        && (data.titleSource is string && data.titleSource in ['words', 'llm', 'user'])
        && (!('conceptType' in data) || (data.conceptType is string && data.conceptType in ['person', 'project', 'mood', 'other']))
        && (!('parent' in data) || data.parent is string)
        && (!('projectKind' in data) || (data.projectKind is string && data.projectKind in ['build', 'content']))
        && (!('projectStatus' in data) || (data.projectStatus is string && data.projectStatus in ['active', 'nearly-done', 'maintenance', 'waiting', 'done', 'new']))
        && (!('synonyms' in data) || data.synonyms is list)
        && data.links is list
        && data.tags is list
        && (!('templateMode' in data) || (data.templateMode is string && data.templateMode in ['living', 'entry']))
        && (!('fromTemplate' in data) || data.fromTemplate is string)
        && data.archived is bool
        && (!('mergedInto' in data) || data.mergedInto is string)
        && (!('settledAt' in data) || data.settledAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.updatedBy is string && data.updatedBy in ['user', 'claude'])
        && data.deviceId is string
        && (!('baseHash' in data) || data.baseHash is string);
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['text', 'status', 'createdBy'])
        && data.keys().hasOnly(['text', 'dueAt', 'recurrence', 'status', 'snoozedUntil', 'nextFireAt', 'noteId', 'template', 'createdBy'])
        && data.text is string
        && (!('dueAt' in data) || data.dueAt is timestamp)
        && (!('recurrence' in data) || data.recurrence is map)
        && (data.status is string && data.status in ['open', 'done', 'snoozed'])
        && (!('snoozedUntil' in data) || data.snoozedUntil is timestamp)
        && (!('nextFireAt' in data) || data.nextFireAt is timestamp)
        && (!('noteId' in data) || data.noteId is string)
        && (!('template' in data) || data.template is string)
        && (data.createdBy is string && data.createdBy in ['user', 'claude']);
    }

    function isValidDevice(data) {
      return data.keys().hasAll(['token', 'updatedAt'])
        && data.keys().hasOnly(['token', 'updatedAt'])
        && data.token is string
        && data.updatedAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['theme', 'mode', 'updatedAt'])
        && data.keys().hasOnly(['theme', 'mode', 'updatedAt'])
        && (data.theme is string && data.theme in ['herbarium', 'night', 'moss', 'bog', 'pixel'])
        && (data.mode is string && data.mode in ['system', 'light', 'dark'])
        && data.updatedAt is timestamp;
    }

    function isValidAttachment(data) {
      return data.keys().hasAll(['kind', 'name', 'toRead', 'read', 'createdAt', 'updatedAt', 'createdBy'])
        && data.keys().hasOnly(['kind', 'name', 'noteId', 'path', 'url', 'driveFileId', 'contentType', 'size', 'width', 'height', 'thumbPath', 'toRead', 'read', 'createdAt', 'updatedAt', 'createdBy'])
        && (data.kind is string && data.kind in ['image', 'pdf', 'link', 'drive'])
        && data.name is string
        && (!('noteId' in data) || data.noteId is string)
        && (!('path' in data) || data.path is string)
        && (!('url' in data) || data.url is string)
        && (!('driveFileId' in data) || data.driveFileId is string)
        && (!('contentType' in data) || data.contentType is string)
        && (!('size' in data) || data.size is number)
        && (!('width' in data) || data.width is number)
        && (!('height' in data) || data.height is number)
        && (!('thumbPath' in data) || data.thumbPath is string)
        && data.toRead is bool
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.createdBy is string && data.createdBy in ['user', 'claude']);
    }
    // AUTOGENERATED END

    match /users/{uid} {
      allow read: if isOwner(uid);

      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidNote(request.resource.data);

        match /history/{versionId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidReminder(request.resource.data);
      }

      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidDevice(request.resource.data);
      }

      // One doc, settings/app: theme and mode, written by any device.
      match /settings/{settingsId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && settingsId == 'app'
          && isValidSettings(request.resource.data);
      }

      match /activity/{runId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /attachments/{attachmentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidAttachment(request.resource.data);
      }

      // Nightly suggestions (#35): made by a function; the owner only
      // accepts or dismisses an open one, and a trigger applies it.
      match /proposals/{proposalId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && resource.data.status == 'open'
          && request.resource.data.status in ['accepted', 'dismissed']
          && request.resource.data.decidedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'decidedAt']);
        allow create, delete: if false;
      }
    }
  }
}
