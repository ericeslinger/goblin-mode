{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@mossgoblin/schema": ["./packages/schema/src/index.ts"],
      "@mossgoblin/editor": ["./packages/editor/src/index.ts"],
      "@mossgoblin/editor/grammar": ["./packages/editor/src/grammar/index.ts"]
    }
  }
}
